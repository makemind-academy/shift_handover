{
  "type": "page",
  "metadata": {
    "title": "Handover board"
  },
  "onInit": {
    "type": "tool",
    "tool": "shift.state",
    "params": {}
  },
  "state": {
    "initial": {
      "crew": "",
      "shiftLabel": "",
      "openCount": 0,
      "rows": [],
      "worst": 0,
      "worstNote": "",
      "closedCount": 0,
      "closedLine": "",
      "handoverRule": "",
      "notice": ""
    }
  },
  "content": {
    "type": "container",
    "decoration": {
      "color": "{{theme.color.surfaceContainerHighest}}"
    },
    "child": {
      "type": "linear",
      "direction": "vertical",
      "children": [
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 20,
            "bottom": 16
          },
          "decoration": {
            "color": "{{theme.color.surface}}",
            "border": {
              "bottom": true,
              "color": "{{theme.color.outline}}",
              "width": 1
            }
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "{{crew}}",
                    "style": {
                      "fontSize": 13,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 2.2
                    }
                  },
                  {
                    "type": "text",
                    "content": "Handover board",
                    "style": {
                      "fontSize": 21,
                      "color": "{{theme.color.onSurface}}",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "gap": 4
              },
              {
                "type": "spacer"
              },
              {
                "type": "linear",
                "direction": "vertical",
                "children": [
                  {
                    "type": "text",
                    "content": "OPEN",
                    "style": {
                      "fontSize": 11,
                      "color": "{{theme.color.onSurfaceVariant}}",
                      "letterSpacing": 1.6
                    }
                  },
                  {
                    "type": "text",
                    "content": "{{openCount}}",
                    "style": {
                      "fontSize": 26,
                      "color": "{{theme.color.onSurface}}",
                      "fontFamily": "JetBrainsMono"
                    }
                  }
                ],
                "gap": 4,
                "crossAxisAlignment": "end"
              },
              {
                "type": "container",
                "padding": {
                  "left": 28,
                  "right": 0,
                  "top": 0,
                  "bottom": 0
                },
                "child": {
                  "type": "linear",
                  "direction": "vertical",
                  "children": [
                    {
                      "type": "text",
                      "content": "CLOSED THIS SHIFT",
                      "style": {
                        "fontSize": 11,
                        "color": "{{theme.color.onSurfaceVariant}}",
                        "letterSpacing": 1.6
                      }
                    },
                    {
                      "type": "text",
                      "content": "{{closedCount}}",
                      "style": {
                        "fontSize": 26,
                        "color": "{{theme.color.onSurface}}",
                        "fontFamily": "JetBrainsMono"
                      }
                    }
                  ],
                  "gap": 4,
                  "crossAxisAlignment": "end"
                }
              }
            ]
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 10,
            "bottom": 4
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "button",
                "label": "Hand over",
                "variant": "filled",
                "onTap": {
                  "type": "tool",
                  "tool": "shift.handover",
                  "params": {}
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Close #3: supplier credited",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "shift.close",
                  "params": {
                    "id": 3,
                    "note": "supplier credited, 6 short"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Close #2: reader replaced",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "shift.close",
                  "params": {
                    "id": 2,
                    "note": "reader swapped, lane 3 back"
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Close #1 (no note)",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "shift.close",
                  "params": {
                    "id": 1,
                    "note": ""
                  }
                }
              },
              {
                "type": "box",
                "width": 10
              },
              {
                "type": "button",
                "label": "Close #1: chiller serviced",
                "variant": "outlined",
                "onTap": {
                  "type": "tool",
                  "tool": "shift.close",
                  "params": {
                    "id": 1,
                    "note": "compressor fan replaced, holding 3 C"
                  }
                }
              }
            ]
          }
        },
        {
          "type": "expanded",
          "child": {
            "type": "container",
            "padding": {
              "left": 24,
              "right": 24,
              "top": 16,
              "bottom": 8
            },
            "child": {
              "type": "container",
              "padding": {
                "all": 18
              },
              "decoration": {
                "color": "{{theme.color.surface}}",
                "borderRadius": 14,
                "border": {
                  "color": "{{theme.color.outline}}",
                  "width": 1
                }
              },
              "child": {
                "type": "list",
                "items": "{{rows}}",
                "shrinkWrap": true,
                "itemSpacing": 10,
                "emptyMessage": "Nothing open — the shift ends clean",
                "itemTemplate": {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "container",
                      "width": 44,
                      "child": {
                        "type": "text",
                        "content": "{{item.id}}",
                        "textAlign": "start",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 15,
                          "color": "{{theme.color.primary}}",
                          "textAlign": "start",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerStart"
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "expanded",
                      "child": {
                        "type": "text",
                        "content": "{{item.text}}",
                        "style": {
                          "fontSize": 16,
                          "color": "{{theme.color.onSurface}}"
                        }
                      }
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "container",
                      "width": 150,
                      "child": {
                        "type": "text",
                        "content": "{{item.carried}}",
                        "textAlign": "end",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 13,
                          "color": "{{theme.color.warning}}",
                          "textAlign": "end",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerEnd"
                    },
                    {
                      "type": "box",
                      "width": 0
                    },
                    {
                      "type": "container",
                      "width": 110,
                      "child": {
                        "type": "text",
                        "content": "{{item.from}}",
                        "textAlign": "end",
                        "maxLines": 1,
                        "style": {
                          "fontSize": 13,
                          "color": "{{theme.color.onSurfaceVariant}}",
                          "textAlign": "end",
                          "fontFamily": "JetBrainsMono"
                        }
                      },
                      "alignment": "centerEnd"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 6,
            "bottom": 8
          },
          "child": {
            "type": "container",
            "padding": {
              "all": 18
            },
            "decoration": {
              "color": "{{theme.color.surface}}",
              "borderRadius": 14,
              "border": {
                "color": "{{theme.color.outline}}",
                "width": 1
              }
            },
            "child": {
              "type": "linear",
              "direction": "vertical",
              "children": [
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "OLDEST STILL OPEN",
                      "style": {
                        "fontSize": 11,
                        "color": "{{theme.color.onSurfaceVariant}}",
                        "letterSpacing": 1.6
                      }
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "content": "{{worstLabel}}",
                      "style": {
                        "fontSize": 15,
                        "color": "{{theme.color.warning}}",
                        "fontFamily": "JetBrainsMono"
                      }
                    }
                  ]
                },
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "{{worstNote}}",
                      "style": {
                        "fontSize": 13,
                        "color": "{{theme.color.onSurfaceVariant}}"
                      }
                    }
                  ]
                },
                {
                  "type": "divider",
                  "color": "{{theme.color.outline}}"
                },
                {
                  "type": "linear",
                  "direction": "horizontal",
                  "crossAxisAlignment": "center",
                  "children": [
                    {
                      "type": "text",
                      "content": "Closed",
                      "style": {
                        "fontSize": 13,
                        "color": "{{theme.color.onSurfaceVariant}}"
                      }
                    },
                    {
                      "type": "spacer"
                    },
                    {
                      "type": "text",
                      "content": "{{closedLine}}",
                      "style": {
                        "fontSize": 13,
                        "color": "{{theme.color.onSurface}}"
                      }
                    }
                  ]
                }
              ],
              "gap": 10
            }
          }
        },
        {
          "type": "container",
          "padding": {
            "left": 24,
            "right": 24,
            "top": 4,
            "bottom": 18
          },
          "child": {
            "type": "linear",
            "direction": "horizontal",
            "crossAxisAlignment": "center",
            "children": [
              {
                "type": "text",
                "content": "{{handoverRule}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.onSurfaceVariant}}"
                }
              },
              {
                "type": "spacer"
              },
              {
                "type": "text",
                "content": "{{notice}}",
                "style": {
                  "fontSize": 13,
                  "color": "{{theme.color.primary}}"
                }
              }
            ]
          }
        }
      ],
      "crossAxisAlignment": "stretch"
    }
  }
}
